# Server Port
PORT=5000

# Official Clash of Clans REST API Token (Get from https://developer.clashofclans.com/)
COC_API_TOKEN=#Your COC_API_TOKEN

# Default Player & Clan Tags for initial dashboard load (include # symbol or plain tag)
DEFAULT_PLAYER_TAG=#Your Player Tag
DEFAULT_CLAN_TAG=#Your Clan Tag

# Optional: Render Backend URL for Vercel Cron relay (e.g. https://clashstat-backend.onrender.com)
RENDER_BACKEND_URL=
